PORT=3000

SECRET_PROVIDER=azure

# --- Local: Azure Key Vault emulator (docker compose up keyvault) ---
# host must be a subdomain of the emulator's challenge resource (localhost)
AZURE_KEYVAULT_URL=https://primary.localhost:8443
# DefaultAzureCredential -> ManagedIdentityCredential -> emulator's fake token endpoint
IDENTITY_ENDPOINT=http://localhost:8080/metadata/identity/oauth2/token
IDENTITY_HEADER=header
# emulator uses a self-signed certificate (local dev only!)
NODE_TLS_REJECT_UNAUTHORIZED=0

# --- Real Azure Key Vault: replace the block above with ---
# AZURE_KEYVAULT_URL=https://<your-keyvault-name>.vault.azure.net/
# AZURE_TENANT_ID=<your-tenant-id>
# AZURE_CLIENT_ID=<your-client-id>
# AZURE_CLIENT_SECRET=<your-client-secret>

# --- Auth storage (users, passkeys, OAuth codes/tokens): mongo | postgres ---
AUTH_DB=mongo
# mongo (native driver)
MONGO_URL=mongodb://localhost:27017
MONGO_DB=keyvault
# postgres (Drizzle ORM) — migrations in ./drizzle run automatically on startup
DATABASE_URL=postgres://keyvault:keyvault@localhost:5432/keyvault

# --- WebAuthn / passkeys (fido2-lib) ---
# rpId must equal (or be a registrable suffix of) the browser's hostname
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Key Vault
# comma separated, exact origins the browser runs on (vite dev + built app)
WEBAUTHN_ORIGINS=http://localhost:5173,http://localhost:3000

# --- OAuth2 (Authorization Code + PKCE, public SPA client) ---
OAUTH_CLIENT_ID=keyvault-web
OAUTH_REDIRECT_URIS=http://localhost:5173/callback,http://localhost:3000/callback
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# --- OpenID Connect (ID Token when scope includes "openid") ---
# Issuer = public base URL of this server (https in production); also used in the discovery document
OIDC_ISSUER=http://localhost:3000
ID_TOKEN_TTL=900
# Signing keys (RS256) are created and rotated automatically and stored in Key Vault (AZURE_KEYVAULT_URL)
# under this secret name — hidden from / blocked in the /secrets API. Rotate now: pnpm oidc:rotate
OIDC_KEYS_SECRET=oidc-signing-keys
OIDC_KEY_ROTATION_DAYS=30
# how long a retired key stays in the JWKS (> ID token lifetime + client JWKS cache)
OIDC_RETIRED_KEY_GRACE_SEC=86400
# how often each instance reloads keys from Key Vault (and rotates if due)
OIDC_KEYS_SYNC_SEC=300
