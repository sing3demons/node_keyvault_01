{
  "name": "node_keyvault",
  "version": "1.0.0",
  "private": true,
  "description": "HTTP API (built-in kp framework) + React UI for managing secrets in Azure Key Vault (or a local emulator).",
  "main": "dist/server.js",
  "scripts": {
    "dev": "pnpm run \"/^dev:/\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "test:e2e": "node test/e2e/run.mjs",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "oidc:rotate": "tsx src/cli/rotate-oidc-key.ts",
    "master:enable": "tsx src/cli/master-enable.ts",
    "master:create": "tsx src/cli/master-create.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@azure/identity": "^4.11.1",
    "@azure/keyvault-secrets": "^4.9.0",
    "argon2": "^0.45.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.4",
    "fido2-lib": "^4.0.1",
    "jose": "6.2.18",
    "mongodb": "^7.9.1",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "~0.31.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "packageManager": "pnpm@11.22.0"
}
