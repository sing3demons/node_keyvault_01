{
  "name": "node_keyvault",
  "version": "1.0.0",
  "private": true,
  "description": "Hono API + React UI for managing secrets in Azure Key Vault (or a local emulator).",
  "main": "dist/server.js",
  "scripts": {
    "dev": "pnpm run \"/^dev:/\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "start": "node dist/server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@azure/identity": "^4.11.1",
    "@azure/keyvault-secrets": "^4.9.0",
    "@hono/node-server": "^2.1.9",
    "dotenv": "^17.2.3",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "packageManager": "pnpm@11.22.0"
}
